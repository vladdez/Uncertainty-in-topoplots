{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile journal (format first)",
      "type": "process",
      "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\compile-journal.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Preview website locally",
      "type": "process",
      "command": "quarto",
      "args": ["preview", "--no-browser", "--port", "4200"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Render audit site (keep open pages)",
      "type": "process",
      "command": "quarto",
      "args": ["render", "reports", "--no-clean"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
